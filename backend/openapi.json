      "RiskTier": {
        "type": "integer",
        "enum": [
          1,
          2,
          3,
          4
        ],
        "title": "RiskTier",
        "description": "Ordered flood-risk tiers used by every downstream consumer.\n\nIntEnum gives us a natural ordering (``RiskTier.HIGH > RiskTier.MEDIUM``)\n*and* lets us serialise the value as a plain integer for storage/API\npurposes without writing a custom codec. The ordering itself encodes the\nsingle-hop escalation semantics used by :class:`EscalationEngine`:\nincrementing by one level moves to the next tier, and ``DANGER`` is the\nhard cap."
      },
