# Copy to `.env` and fill in real values for local development.
# This file is safe to commit — no real secrets, only placeholder structure.

# --- PostgreSQL with PostGIS (local docker-compose) ---
DATABASE_URL=postgresql+asyncpg://swat:swat_dev_password@localhost:5432/swat_flood
POSTGRES_USER=swat
POSTGRES_PASSWORD=swat_dev_password
POSTGRES_DB=swat_flood

# --- Redis (local docker-compose) ---
REDIS_URL=redis://localhost:6379/0

# --- Weather provider: Open-Meteo (keyless, free) ---
# No API key required for Open-Meteo. Host override for optional self-hosting / proxy.
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- Auth ---
JWT_SECRET_KEY=replace_me_with_a_long_random_string_from_secrets
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Notifications (FCM — stub only initially) ---
# FCM_SERVICE_ACCOUNT_JSON_PATH=
